---
import '@post-embed/elements/x/theme.css'
interface Props {
  url?: string
}
const { url = 'https://x.com/jack/status/20' } = Astro.props
---

<post-embed-remote-demo>
  <form>
    <label>
      Post URL or ID
      <input name="url" type="text" value={url} spellcheck="false" />
    </label>
    <button type="submit">Load</button>
  </form>
  <p data-status role="status"></p>
  <div data-preview></div>
  <details><summary>Raw data</summary><pre></pre></details>
</post-embed-remote-demo>

<script>
  import { registerXPost } from '@post-embed/elements/x'
  import type { Tweet } from '@post-embed/types'

  registerXPost()

  const API_URL = 'https://react-tweet.vercel.app/api/tweet/'

  function parseTweetId(input: string): string | undefined {
    const value = input.trim()
    if (/^\d+$/.test(value)) return value
    try {
      return new URL(value).pathname.match(/\/status(?:es)?\/(\d+)/)?.[1]
    } catch {
      return undefined
    }
  }

  class PostEmbedRemoteDemo extends HTMLElement {
    connectedCallback() {
      if (this.querySelector('post-embed-x-post')) return
      const form = this.querySelector('form')!
      const input = form.elements.namedItem('url') as HTMLInputElement
      const status = this.querySelector<HTMLElement>('[data-status]')!
      const raw = this.querySelector('pre')!
      const element = document.createElement('post-embed-x-post')
      this.querySelector('[data-preview]')!.append(element)

      const load = async () => {
        const id = parseTweetId(input.value)
        if (!id) {
          status.textContent =
            'Enter a post URL like https://x.com/jack/status/20 or a numeric ID.'
          return
        }
        status.textContent = `Loading ${id}…`
        element.data = null
        raw.textContent = ''
        try {
          const response = await fetch(API_URL + id)
          const json = (await response.json()) as { data?: Tweet | null }
          if (!response.ok || !json.data) {
            status.textContent = `Post ${id} was not found (HTTP ${response.status}).`
            return
          }
          element.data = json.data
          raw.textContent = JSON.stringify(json.data, null, 2)
          status.textContent = `Loaded ${id} from ${API_URL}`
        } catch (error) {
          status.textContent = `Failed to load ${id}: ${String(error)}`
        }
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault()
        void load()
      })
      void load()
    }
  }
  if (!customElements.get('post-embed-remote-demo'))
    customElements.define('post-embed-remote-demo', PostEmbedRemoteDemo)
</script>

<style>
  post-embed-remote-demo {
    display: block;
    max-width: 42rem;
    margin: 2rem auto;
    padding: 1rem;
    font: 16px/1.5 system-ui;
    color: #253044;
    background: #fff;
    --post-embed-border-color: #cbd5e1;
    --post-embed-muted-color: #526074;
  }
  form {
    display: flex;
    gap: 0.5rem;
    align-items: end;
    margin-bottom: 1rem;
  }
  label {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9rem;
  }
  input,
  button {
    font: inherit;
  }
  button {
    cursor: pointer;
  }
  [data-status] {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: #526074;
  }
  details {
    margin-top: 1rem;
  }
  pre {
    overflow: auto;
    max-height: 24rem;
    font-size: 0.8rem;
  }
</style>
