---
interface Props {
  title: string
}
const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <h1>{title}</h1>
    <div class="columns">
      <section class="light" data-samples></section>
      <section class="dark" data-samples></section>
    </div>
    <script>
      import { registerXPost } from '@post-embed/elements/x'
      import { createSamples } from './samples.ts'

      registerXPost()
      for (const section of document.querySelectorAll('[data-samples]')) {
        for (const tweet of createSamples()) {
          const element = document.createElement('post-embed-x-post')
          element.data = tweet
          section.append(element)
        }
      }
    </script>
    <style is:global>
      body {
        margin: 0;
        padding: 24px;
        background: #e9ebef;
        font:
          15px/1.45 -apple-system,
          system-ui,
          'Segoe UI',
          sans-serif;
        color: #111;
      }
      h1 {
        margin: 0 0 16px;
        font-size: 18px;
        font-weight: 600;
      }
      .columns {
        display: grid;
        grid-template-columns: repeat(2, 540px);
        gap: 24px;
        align-items: start;
      }
      section {
        display: grid;
        gap: 24px;
        padding: 28px;
        border-radius: 12px;
      }
      .light {
        color-scheme: light;
        color: #0f1419;
        background: #fff;
      }
      .dark {
        color-scheme: dark;
        color: #e7e9ea;
        background: #0b0f14;
      }
    </style>
  </body>
</html>
