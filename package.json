{
  "name": "@starter-monorepo/monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Monorepo for the starter monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint --max-warnings=0 .",
    "lint:prettier": "prettier --check .",
    "typecheck": "tsc -b",
    "fix": "pnpm run fix:tsconfig && pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:prettier": "prettier --write .",
    "fix:eslint": "eslint . --fix",
    "fix:tsconfig": "monorepo-typescript-references fix"
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.16.1",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.1.0",
    "monorepo-typescript-references": "^1.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.9.1",
    "typescript": "^6.0.3"
  }
}
