{
  "name": "post-embed",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "Snapshot post components for the web",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint --max-warnings=0 .",
    "lint:prettier": "prettier --check .",
    "typecheck": "tsc -b",
    "fix": "pnpm run fix:tsconfig && pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:prettier": "prettier --write .",
    "fix:eslint": "eslint . --fix",
    "fix:tsconfig": "monorepo-typescript-references fix",
    "test": "vitest",
    "test:run": "vitest run",
    "build:package": "turbo run build --filter='./packages/*'",
    "change": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "pnpm --filter='./packages/*' publish --access public --no-git-checks --tag latest",
    "ci:publish:snapshot": "pkg-pr-new publish --pnpm ./packages/elements ./packages/exporter ./packages/schema ./packages/types",
    "size": "pnpm run build:package && size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@ocavue/eslint-config": "^4.16.1",
    "@ocavue/tsconfig": "^0.7.1",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "monorepo-typescript-references": "^1.1.2",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "size-limit": "^14.0.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
