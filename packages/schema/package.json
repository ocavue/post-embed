{
  "name": "@post-embed/schema",
  "type": "module",
  "version": "0.0.1",
  "description": "Standard Schema validation with type defaults for embedded posts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocavue/post-embed.git",
    "directory": "packages/schema"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --typecheck --bail 1"
  },
  "dependencies": {
    "@post-embed/types": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
