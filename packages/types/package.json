{
  "name": "@post-embed/types",
  "type": "module",
  "version": "0.0.1",
  "description": "Shared post embed types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocavue/post-embed.git",
    "directory": "packages/types"
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal/*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "react-tweet": "3.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal/*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  }
}
